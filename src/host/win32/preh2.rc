/* preh2.rc - Prehistorik2.exe's resources: the program icon (preh2_icon.png, tools/png2ico.py) and
 * the version information, v1.1. */
#include <winver.h>

1 ICON "preh2.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Prehistorik 2 64bit (PreH2)"
            VALUE "FileVersion", "1.1"
            VALUE "InternalName", "Prehistorik2"
            VALUE "LegalCopyright", "Copyright (c) 2026 Onur BUYUKCAGLAR"
            VALUE "OriginalFilename", "Prehistorik2.exe"
            VALUE "ProductName", "Prehistorik 2 64bit"
            VALUE "ProductVersion", "1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
